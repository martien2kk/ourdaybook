page { background:#faf7f2; color:#322f2c; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
.page { min-height:100vh; padding:32rpx; box-sizing:border-box; }
.tab-page { padding-bottom:calc(144rpx + env(safe-area-inset-bottom)); }
.card { background:#fff; border-radius:28rpx; padding:30rpx; margin-bottom:24rpx; box-shadow:0 10rpx 30rpx rgba(90,70,50,.07); }
.eyebrow { color:#e86f61; font-size:24rpx; letter-spacing:3rpx; font-weight:600; }
.title { font-size:44rpx; line-height:1.35; font-weight:700; margin:16rpx 0; }
.subtitle,.muted { color:#88827b; line-height:1.65; }
.btn { margin-top:22rpx; border:0; border-radius:999rpx; background:#e86f61; color:#fff; font-weight:600; }
.btn::after { border:0; }
.btn.secondary { background:#f2ebe4; color:#6c5d52; }
.btn.danger { background:#fff0ee; color:#c64d43; }
.row { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.input { background:#f7f3ef; border-radius:18rpx; padding:22rpx; margin:14rpx 0; }
input.input { height:76rpx; min-height:76rpx; padding:0 22rpx; line-height:76rpx; box-sizing:border-box; }
.tag { display:inline-block; padding:8rpx 18rpx; border-radius:999rpx; background:#f5ece7; color:#a95349; font-size:24rpx; }
.photo { width:100%; height:420rpx; border-radius:22rpx; background:#eee8e1; }
.grid2 { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; }
.section-title { font-size:32rpx; font-weight:700; margin-bottom:18rpx; }
.notice { padding:20rpx; border-radius:18rpx; background:#fff6dd; color:#806729; line-height:1.5; font-size:25rpx; margin-bottom:24rpx; }
.empty { text-align:center; padding:70rpx 20rpx; color:#948d86; }
.theme-minimal { background:transparent; color:#4d4844; position:relative; z-index:0; }
.space-theme-bg.minimal-theme-bg { opacity:1; filter:brightness(1.01) saturate(.86) contrast(.98); }
.theme-minimal .card { background:rgba(252,250,246,.64); color:#4d4844; border:1rpx solid rgba(110,105,99,.13); box-shadow:0 10rpx 28rpx rgba(90,82,74,.08); -webkit-backdrop-filter:none; backdrop-filter:none; }
.theme-minimal .title,.theme-minimal .section-title { color:#3f3b38; letter-spacing:1rpx; text-shadow:none; }
.theme-minimal .muted,.theme-minimal .subtitle { color:#77716a; }
.theme-minimal .eyebrow { color:#69645f; }
.theme-minimal .btn { background:rgba(154,114,90,.94); color:#fffdf9; border:1rpx solid rgba(190,155,132,.38); box-shadow:0 7rpx 18rpx rgba(93,63,45,.14); }
.theme-minimal .btn.secondary { background:rgba(251,249,245,.76); color:#625c57; border:1rpx solid rgba(110,105,99,.13); box-shadow:none; }
.theme-minimal .btn.danger { background:rgba(98,92,87,.09); color:#625c57; border-color:rgba(98,92,87,.15); }
.theme-minimal .tag { background:rgba(154,114,90,.1); color:#785743; border:1rpx solid rgba(154,114,90,.18); }
.theme-minimal .input { background:rgba(250,248,244,.78); color:#4d4844; border:1rpx solid rgba(110,105,99,.12); box-sizing:border-box; }
.theme-minimal .notice { background:rgba(244,239,231,.62); color:#655f5a; border:1rpx solid rgba(126,117,107,.12); -webkit-backdrop-filter:none; backdrop-filter:none; }
.theme-minimal .empty { color:#8b847d; }
.theme-minimal .photo { background:rgba(239,235,228,.68); }
.theme-minimal switch .wx-switch-input { background:#d6d0c8!important; border-color:#b9b1a9!important; }
.theme-minimal switch .wx-switch-input::before { background:#d6d0c8!important; }
.theme-minimal switch .wx-switch-input::after { background:#fffdf9!important; box-shadow:0 2rpx 8rpx rgba(74,68,62,.18)!important; }
.theme-minimal switch .wx-switch-input.wx-switch-input-checked { background:#9a725a!important; border-color:#b58d73!important; }
.theme-warm { background:transparent; color:#4b352c; position:relative; z-index:0; }
.space-theme-bg.warm-theme-bg { opacity:1; filter:brightness(1.15) saturate(.92) contrast(.98); }
.theme-warm .card { background:rgba(248,239,224,.76); color:#4b352c; border:1rpx solid rgba(151,99,69,.14); box-shadow:0 12rpx 30rpx rgba(104,63,34,.13); -webkit-backdrop-filter:blur(5rpx); backdrop-filter:blur(5rpx); }
.theme-warm .title,.theme-warm .section-title { color:#493229; letter-spacing:1rpx; text-shadow:0 2rpx 12rpx rgba(119,73,42,.1); }
.theme-warm .muted,.theme-warm .subtitle { color:#806b60; }
.theme-warm .eyebrow { color:#a95f4e; }
.theme-warm .btn { background:rgba(201,121,104,.9); color:#fffaf4; border:1rpx solid rgba(245,198,180,.4); box-shadow:0 8rpx 22rpx rgba(119,65,43,.14); }
.theme-warm .btn.secondary { background:rgba(255,252,245,.52); color:#6d5245; border:1rpx solid rgba(151,99,69,.13); box-shadow:none; }
.theme-warm .btn.danger { background:rgba(178,73,67,.12); color:#a34d48; border-color:rgba(178,73,67,.18); }
.theme-warm .tag { background:rgba(201,121,104,.13); color:#9b574a; border:1rpx solid rgba(201,121,104,.2); }
.theme-warm .input { background:rgba(255,252,245,.48); color:#4b352c; border:1rpx solid rgba(151,99,69,.12); box-sizing:border-box; }
.theme-warm .notice { background:rgba(255,247,224,.6); color:#795d37; border:1rpx solid rgba(171,121,72,.14); -webkit-backdrop-filter:blur(4rpx); backdrop-filter:blur(4rpx); }
.theme-warm .empty { color:#91776a; }
.theme-warm .photo { background:rgba(255,248,235,.45); }
.theme-warm switch .wx-switch-input { background:#c9b3a5!important; border-color:#aa8d7c!important; }
.theme-warm switch .wx-switch-input::before { background:#c9b3a5!important; }
.theme-warm switch .wx-switch-input::after { background:#fffaf4!important; box-shadow:0 2rpx 8rpx rgba(91,53,35,.22)!important; }
.theme-warm switch .wx-switch-input.wx-switch-input-checked { background:#c97968!important; border-color:#d99a89!important; }
.theme-calm { background:transparent; color:#f4f0ea; position:relative; z-index:0; }
.space-theme-bg { position:fixed; inset:0; width:100vw; height:100vh; z-index:-1; opacity:1; filter:brightness(1.16) contrast(1.28); }
.theme-calm .card { background:rgba(15,16,18,.76); color:#f4f0ea; border:1rpx solid rgba(255,255,255,.15); box-shadow:0 12rpx 30rpx rgba(0,0,0,.25); -webkit-backdrop-filter:blur(5rpx); backdrop-filter:blur(5rpx); }
.theme-calm .title,.theme-calm .section-title { color:#f7f3ed; letter-spacing:1rpx; text-shadow:0 2rpx 12rpx rgba(0,0,0,.28); }
.theme-calm .muted,.theme-calm .subtitle { color:#b9b2aa; }
.theme-calm .eyebrow { color:#d8d0c7; }
.theme-calm .btn { background:rgba(240,143,179,.94); color:#25151e; border:1rpx solid rgba(255,205,224,.4); box-shadow:0 8rpx 22rpx rgba(0,0,0,.2); }
.theme-calm .btn.secondary { background:rgba(255,255,255,.09); color:#e8e2db; border:1rpx solid rgba(255,255,255,.14); box-shadow:none; }
.theme-calm .btn.danger { background:rgba(163,65,61,.2); color:#f2aaa4; border-color:rgba(242,170,164,.24); }
.theme-calm .tag { background:rgba(240,143,179,.16); color:#ffc1d8; border:1rpx solid rgba(240,143,179,.28); }
.theme-calm .input { background:rgba(15,16,18,.48); color:#f4f0ea; border:1rpx solid rgba(255,255,255,.12); box-sizing:border-box; }
.theme-calm .notice { background:rgba(15,16,18,.6); color:#d2cbc3; border:1rpx solid rgba(255,255,255,.14); -webkit-backdrop-filter:blur(4rpx); backdrop-filter:blur(4rpx); }
.theme-calm .empty { color:#aaa39c; }
.theme-calm .photo { background:rgba(255,255,255,.06); }
.theme-calm switch .wx-switch-input { background:#55575d!important; border-color:#85878e!important; box-shadow:0 0 0 2rpx rgba(255,255,255,.08)!important; }
.theme-calm switch .wx-switch-input::before { background:#55575d!important; }
.theme-calm switch .wx-switch-input::after { background:#fff!important; box-shadow:0 2rpx 8rpx rgba(0,0,0,.35)!important; }
.theme-calm switch .wx-switch-input.wx-switch-input-checked { background:#f08fb3!important; border-color:#f7b4cd!important; }
.theme-blue { background:transparent; color:#eff5ff; position:relative; z-index:0; }
.blue-theme-bg { opacity:1; filter:brightness(1.01) contrast(1.16); }
.theme-blue .card { background:rgba(5,10,22,.6); color:#f2f6ff; border:1rpx solid rgba(174,202,255,.16); box-shadow:0 12rpx 30rpx rgba(0,5,18,.27); -webkit-backdrop-filter:blur(5rpx); backdrop-filter:blur(5rpx); }
.theme-blue .title,.theme-blue .section-title { color:#f4f7ff; letter-spacing:1rpx; text-shadow:0 2rpx 12rpx rgba(0,8,30,.3); }
.theme-blue .muted,.theme-blue .subtitle { color:#b9c8e6; }
.theme-blue .eyebrow { color:#a9c8ff; }
.theme-blue .btn { background:rgba(143,181,255,.94); color:#07142d; border:1rpx solid rgba(205,222,255,.42); box-shadow:0 8rpx 22rpx rgba(0,8,35,.22); }
.theme-blue .btn.secondary { background:rgba(220,232,255,.09); color:#dbe7ff; border:1rpx solid rgba(184,207,255,.16); box-shadow:none; }
.theme-blue .btn.danger { background:rgba(174,73,99,.2); color:#ffc0d0; border-color:rgba(255,192,208,.24); }
.theme-blue .tag { background:rgba(143,181,255,.14); color:#c6d9ff; border:1rpx solid rgba(143,181,255,.23); }
.theme-blue .input { background:rgba(220,232,255,.075); color:#f2f6ff; border:1rpx solid rgba(184,207,255,.14); box-sizing:border-box; }
.theme-blue .notice { background:rgba(5,10,22,.56); color:#c9d5ec; border:1rpx solid rgba(174,202,255,.14); -webkit-backdrop-filter:blur(4rpx); backdrop-filter:blur(4rpx); }
.theme-blue .empty { color:#aab9d6; }
.theme-blue .photo { background:rgba(135,173,245,.08); }
.theme-blue switch .wx-switch-input { background:#435374!important; border-color:#748bb6!important; box-shadow:0 0 0 2rpx rgba(183,209,255,.08)!important; }
.theme-blue switch .wx-switch-input::before { background:#435374!important; }
.theme-blue switch .wx-switch-input::after { background:#fff!important; box-shadow:0 2rpx 8rpx rgba(0,7,25,.35)!important; }
.theme-blue switch .wx-switch-input.wx-switch-input-checked { background:#8fb5ff!important; border-color:#b9d0ff!important; }
