.avatar{width:150rpx;height:150rpx;border-radius:50%;background:#f2ebe4;color:#9a746b;display:flex;align-items:center;justify-content:center;margin:0 auto 32rpx;overflow:hidden}.avatar image{width:100%;height:100%}.themes{display:flex;gap:12rpx;margin:15rpx 0 28rpx}.themes view{padding:12rpx 24rpx;background:#eee8e1;border-radius:99rpx}.themes .active{background:#e86f61;color:#fff}
.field-heading{display:flex;align-items:center;justify-content:space-between}.field-count{font-size:22rpx;color:rgba(90,79,71,.58)}
.date-picker{display:flex;align-items:center;justify-content:space-between;box-sizing:border-box}.date-picker.placeholder{color:#9a948e}
.theme-calm .avatar{background:rgba(255,255,255,.08);color:#c9c2ba;border:1rpx solid rgba(255,255,255,.12)}
.theme-calm .themes view{background:rgba(255,255,255,.08);color:#b9b2aa;border:1rpx solid rgba(255,255,255,.1)}
.theme-calm .themes .active{background:rgba(240,143,179,.94);color:#25151e}
.theme-blue .avatar{background:rgba(220,232,255,.08);color:#c6d9ff;border:1rpx solid rgba(174,202,255,.14)}
.theme-blue .themes view{background:rgba(220,232,255,.08);color:#b9c8e6;border:1rpx solid rgba(174,202,255,.12)}
.theme-blue .themes .active{background:rgba(143,181,255,.94);color:#07142d}
.theme-warm .avatar{background:rgba(255,252,245,.5);color:#9a746b;border:1rpx solid rgba(151,99,69,.12)}
.theme-warm .themes view{background:rgba(255,252,245,.48);color:#806b60;border:1rpx solid rgba(151,99,69,.11)}
.theme-warm .themes .active{background:rgba(201,121,104,.9);color:#fffaf4}
.theme-minimal .avatar{background:rgba(251,249,245,.68);color:#69645f;border:1rpx solid rgba(110,105,99,.12)}
.theme-minimal .themes view{background:rgba(251,249,245,.74);color:#77716a;border:1rpx solid rgba(110,105,99,.11)}
.theme-minimal .themes .active{background:rgba(154,114,90,.94);color:#fffdf9}
