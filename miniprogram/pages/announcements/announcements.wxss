.announcement-page{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.announcement-card{position:relative}.announcement-date{font-size:22rpx;letter-spacing:1rpx;color:#9a725a;margin-bottom:10rpx}.announcement-title{font-size:30rpx;font-weight:700;margin-bottom:14rpx}.announcement-body{font-size:26rpx;line-height:1.75;color:#716a64}.theme-calm .announcement-date{color:#f08fb3}.theme-blue .announcement-date{color:#8fb5ff}.theme-warm .announcement-date{color:#b06d5c}.theme-calm .announcement-body,.theme-blue .announcement-body{color:#c9c4bd}
.announcement-section-header{display:flex;align-items:center;gap:16rpx;margin:34rpx 8rpx 18rpx}.announcement-header-icon{width:54rpx;height:54rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;background:rgba(154,114,90,.14);border:1rpx solid rgba(154,114,90,.2);color:#8a634d;font:700 30rpx/1 serif}.announcement-header-title{font-size:30rpx;font-weight:700;line-height:1.15}.announcement-header-subtitle{margin-top:4rpx;font-size:18rpx;letter-spacing:2rpx;color:#9a8f86}.theme-calm .announcement-header-icon{background:rgba(240,143,179,.13);border-color:rgba(240,143,179,.24);color:#f08fb3}.theme-blue .announcement-header-icon{background:rgba(143,181,255,.13);border-color:rgba(143,181,255,.24);color:#8fb5ff}.theme-warm .announcement-header-icon{background:rgba(201,121,104,.14);border-color:rgba(201,121,104,.22);color:#b66f60}.theme-calm .announcement-header-subtitle,.theme-blue .announcement-header-subtitle{color:#9ca7b9}
.reminder-copy{font-size:24rpx;line-height:1.65}.reminder-button{margin-top:20rpx}.scheduled-box{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-top:20rpx;padding:16rpx 20rpx;border-radius:20rpx;background:rgba(91,143,104,.1);color:#53785c;font-size:25rpx}.cancel-reminder{width:auto;min-width:120rpx;margin:0;padding:0 18rpx;background:transparent;color:#a45e55;font-size:24rpx;line-height:54rpx}.cancel-reminder::after{border:0}.theme-calm .scheduled-box,.theme-blue .scheduled-box{background:rgba(143,181,255,.11);color:#c6d7f8}
