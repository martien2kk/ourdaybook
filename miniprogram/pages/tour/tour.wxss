.tour-page{padding-top:48rpx;padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.privacy-note{margin-top:20rpx}.demo-card{overflow:hidden}.demo-category{font-size:23rpx;color:#8c796d;margin-bottom:12rpx}.demo-photos{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.demo-half image{width:100%;height:250rpx;border-radius:18rpx;display:block}.demo-name{font-size:25rpx;font-weight:600;margin-top:12rpx}.demo-half .muted{font-size:22rpx}.locked-half{position:relative}.locked-half::after{content:'等待共同解锁';position:absolute;left:0;right:0;top:0;height:250rpx;border-radius:18rpx;background:rgba(42,39,36,.48);color:#fff;display:flex;align-items:center;justify-content:center;font-size:23rpx}.preview-grid{display:grid;gap:18rpx}.preview-item{display:flex;align-items:center;gap:22rpx;margin:0}.preview-icon{width:72rpx;height:72rpx;flex:0 0 72rpx;border-radius:22rpx;background:rgba(154,114,90,.12);color:#785743;display:flex;align-items:center;justify-content:center;font-size:25rpx;font-weight:700}.preview-copy{min-width:0}.preview-copy .section-title{margin-bottom:4rpx}.preview-copy .muted{font-size:24rpx;line-height:1.5}.tour-back{margin:22rpx auto 0;background:transparent;color:#77716a;font-size:26rpx}.tour-back::after{border:0}
