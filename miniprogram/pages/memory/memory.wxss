.grid2{display:flex;align-items:stretch;gap:18rpx}
.half{flex:1;min-width:0;padding:15rpx;box-sizing:border-box;overflow:hidden}
.half image{display:block;width:100%;height:330rpx;border-radius:18rpx}
.caption{min-height:72rpx;margin:18rpx 0 10rpx;line-height:1.5;overflow:hidden;overflow-wrap:anywhere;word-break:break-all;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.half .muted{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.backfill-label{margin-top:8rpx;color:#b07a5d;font-size:22rpx}
.entry-prompt{margin:16rpx 0 8rpx;font-weight:600;line-height:1.5}.shared-card-note{margin:20rpx 0;line-height:1.6}
.center{text-align:center}
.personal-memory-grid{grid-template-columns:1fr}
.personal-memory-grid .half image{height:520rpx}
.memory-quote-switcher{display:flex;align-items:center;justify-content:center;gap:16rpx;padding:8rpx 0;white-space:pre-line}
.memory-quote-text{min-width:0}
.memory-quote-icon{flex:none;width:46rpx;height:46rpx;line-height:46rpx;border-radius:50%;text-align:center;color:var(--accent);background:rgba(255,255,255,.06)}
