.page{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.category-note{margin-bottom:18rpx}.category-row,.prompt-row,.add-row{display:grid;align-items:center}.category-row,.prompt-row{grid-template-columns:minmax(0,1fr) 96rpx 48rpx}.category-row,.prompt-row{padding:22rpx 0;border-bottom:1rpx solid rgba(110,105,99,.12)}.category-name{font-weight:600}.category-control{grid-column:2;display:flex;align-items:center;justify-content:flex-end}.category-action{grid-column:3;width:48rpx;display:flex;justify-content:flex-end}.required-badge{padding:10rpx 14rpx;border-radius:999rpx;background:#f4eee8;color:#9a7d73;font-size:22rpx;white-space:nowrap}.add-row{grid-template-columns:minmax(0,1fr) 96rpx 48rpx;margin-top:16rpx;height:62rpx;overflow:hidden}.add-row .grow{grid-column:1;justify-self:start;width:78%;height:62rpx;min-height:62rpx;margin:0}.compact{grid-column:2;justify-self:start;width:90rpx;min-width:90rpx;max-width:90rpx;height:62rpx;line-height:62rpx;margin:0;padding:0;border-radius:999rpx;background:#9a725a;color:#fff;font-size:22rpx}.compact::after,.remove::after,.custom-toggle::after{border:0}.remove{width:48rpx;height:56rpx;padding:0;margin:0;line-height:56rpx;background:transparent;color:#c64d43}.picker-row{display:flex;justify-content:space-between;align-items:center}.custom-toggle{background:transparent;color:#69645f;font-size:25rpx;margin-top:18rpx}.prompt-text{min-width:0}.prompt-text text{display:block}.prompt-text .meta{color:#8b847d;margin-top:8rpx;font-size:24rpx}.empty-small{text-align:center;color:#8b847d;padding:26rpx}.theme-calm .category-row,.theme-calm .prompt-row,.theme-blue .category-row,.theme-blue .prompt-row{border-bottom-color:rgba(255,255,255,.1)}.theme-calm .compact{background:#f08fb3;color:#25151e}.theme-blue .compact{background:#8fb5ff;color:#07142d}.theme-warm .compact{background:#c97968;color:#fff}.theme-calm .custom-toggle,.theme-calm .remove{color:#f5a8c4}.theme-blue .custom-toggle,.theme-blue .remove{color:#b9d0ff}.theme-warm .custom-toggle{color:#a95f4e}
.prompt-row{grid-template-columns:minmax(0,1fr) 48rpx}.prompt-row .category-action{grid-column:2}
.cooldown-note{margin-top:14rpx;padding:14rpx 18rpx;border-radius:16rpx;background:rgba(154,114,90,.1);color:#785743;font-size:24rpx}.compact[disabled]{opacity:.42}
.limit-note{margin-top:14rpx;color:#9a725a;font-size:23rpx;line-height:1.5}
