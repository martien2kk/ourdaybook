.theme-calm .personal-empty-quote,.theme-blue .personal-empty-quote{color:#e4ddd5}.theme-warm .personal-empty-quote{color:#806b60}
.crop-editor{height:92vh;padding:34rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#f7f3ef;overflow:hidden;display:flex;flex-direction:column}.crop-editor-title{text-align:center;font-size:32rpx;font-weight:700}.crop-editor-tip{text-align:center;color:#8b837c;font-size:23rpx;margin:10rpx 0 20rpx}.crop-scene-card{padding:26rpx;border-radius:26rpx;background:#fff;box-shadow:0 12rpx 34rpx rgba(50,40,34,.1);min-height:0}.crop-frame{position:relative;width:100%;height:min(520rpx,52vh);overflow:hidden;border-radius:22rpx;background:#202124;touch-action:none}.crop-backdrop{position:absolute;inset:-24rpx;width:calc(100% + 48rpx);height:calc(100% + 48rpx);filter:blur(22rpx);opacity:.55}.crop-image{position:absolute;display:block;max-width:none}.crop-grid{position:absolute;inset:0;pointer-events:none;border:2rpx solid rgba(255,255,255,.78);background:linear-gradient(to right,transparent 33.1%,rgba(255,255,255,.4) 33.2%,rgba(255,255,255,.4) 33.5%,transparent 33.6%,transparent 66.4%,rgba(255,255,255,.4) 66.5%,rgba(255,255,255,.4) 66.8%,transparent 66.9%),linear-gradient(to bottom,transparent 33.1%,rgba(255,255,255,.4) 33.2%,rgba(255,255,255,.4) 33.5%,transparent 33.6%,transparent 66.4%,rgba(255,255,255,.4) 66.5%,rgba(255,255,255,.4) 66.8%,transparent 66.9%)}.crop-result-note{text-align:center;color:#8b837c;font-size:22rpx;margin-top:16rpx}.crop-actions{display:grid;grid-template-columns:1fr 1fr 1.55fr;gap:16rpx;margin-top:auto;padding-top:22rpx;flex:none}.crop-actions button{margin:0;border-radius:999rpx;font-size:26rpx}.crop-use{background:#9a725a;color:#fff}.crop-reset{background:#eee7e0;color:#665e58}.crop-cancel{background:#29282a;color:#fff}.crop-output-canvas{position:fixed;left:-200vw;top:0;width:360px;height:450px;opacity:0;pointer-events:none}
.crop-editor.theme-calm{background:#08090c;color:#f4f0ea}.crop-editor.theme-calm .crop-scene-card{background:#101114;border:1rpx solid rgba(255,255,255,.12)}.crop-editor.theme-calm .crop-use{background:#e77eaa;color:#24151d}.crop-editor.theme-blue{background:#06102b;color:#f2f6ff}.crop-editor.theme-blue .crop-scene-card{background:#081532;border:1rpx solid rgba(174,202,255,.16)}.crop-editor.theme-blue .crop-use{background:#8fb5ff;color:#07142d}.crop-editor.theme-warm{background:#fff1d8;color:#4b352c}.crop-editor.theme-warm .crop-scene-card{background:rgba(255,252,245,.8)}.crop-editor.theme-warm .crop-use{background:#b18369}
.crop-editor{position:relative;padding-bottom:calc(150rpx + env(safe-area-inset-bottom))}.crop-actions{position:absolute;z-index:20;left:28rpx;right:28rpx;bottom:calc(18rpx + env(safe-area-inset-bottom));margin:0;padding:14rpx;border-radius:999rpx;background:rgba(247,243,239,.96);box-shadow:0 -8rpx 30rpx rgba(20,18,16,.12)}.crop-editor.theme-calm .crop-actions{background:rgba(8,9,12,.96)}.crop-editor.theme-blue .crop-actions{background:rgba(6,16,43,.96)}.crop-editor.theme-warm .crop-actions{background:rgba(255,241,216,.96)}
.crop-editor{padding-bottom:28rpx}.crop-actions{position:relative;z-index:20;left:auto;right:auto;bottom:auto;margin:24rpx 0 0;padding:0;border-radius:0;background:transparent!important;box-shadow:none}
.crop-actions{display:flex;gap:12rpx;width:100%;box-sizing:border-box}.crop-actions button{flex:1;min-width:0;width:auto;padding:0 10rpx;box-sizing:border-box;white-space:nowrap}.crop-actions .crop-use{flex:1.18}
.crop-actions{flex-wrap:wrap}.crop-actions .crop-use{order:-1;flex:0 0 100%;height:76rpx;line-height:74rpx}.crop-actions .crop-cancel,.crop-actions .crop-reset{flex:1 1 calc(50% - 6rpx);height:68rpx;line-height:66rpx}
.crop-actions{display:block}.crop-actions .crop-use{display:block;width:100%;height:76rpx;line-height:74rpx}.crop-secondary-actions{display:flex;gap:12rpx;width:100%;margin-top:12rpx}.crop-secondary-actions button{display:block;flex:1;width:0;min-width:0;height:68rpx;line-height:66rpx;margin:0;padding:0 12rpx;box-sizing:border-box}
.crop-editor.theme-minimal .crop-use{background:#9a725a;color:#fffaf5}.crop-editor.theme-minimal .crop-cancel{background:#4f4944;color:#fffaf5}.crop-editor.theme-minimal .crop-reset{background:#e9e1d9;color:#625950;border:1rpx solid rgba(98,89,80,.12)}
