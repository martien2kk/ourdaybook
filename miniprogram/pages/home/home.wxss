.picker.locked{border-style:solid;opacity:.96}
.locked-input{opacity:.72}
.btn.uploaded[disabled]{background:#aaa7a3!important;color:#f7f5f2!important;border-color:#aaa7a3!important;box-shadow:none!important;opacity:1}
.submit-btn{white-space:nowrap;min-width:330rpx;padding-left:34rpx;padding-right:34rpx}
