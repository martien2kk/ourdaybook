.top{margin-bottom:24rpx}
.home-skeleton{padding-top:24rpx;opacity:.52}.skeleton-line,.skeleton-photo,.skeleton-button{background:rgba(154,114,90,.12);animation:skeleton-pulse 1.2s ease-in-out infinite}.skeleton-line{height:24rpx;border-radius:999rpx;margin-bottom:18rpx}.skeleton-line.short{width:34%}.skeleton-line.title-line{width:70%;height:38rpx;margin-bottom:30rpx}.skeleton-card{padding:26rpx;border-radius:24rpx;background:rgba(252,250,246,.62);border:1rpx solid rgba(110,105,99,.1)}.skeleton-photo{height:300rpx;border-radius:20rpx;margin-bottom:24rpx}.skeleton-button{width:48%;height:68rpx;border-radius:999rpx;margin:26rpx auto 0}@keyframes skeleton-pulse{0%,100%{opacity:.45}50%{opacity:.9}}
.prompt{padding-top:42rpx;padding-bottom:42rpx;background:transparent!important;border:0!important;box-shadow:none!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important}
.prompt-meta{display:flex;align-items:center;justify-content:space-between;min-height:40rpx}.refresh-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:16rpx}.refresh-hint{font-size:21rpx}.refresh-task-text{flex:none;min-width:142rpx;height:54rpx;line-height:52rpx;margin:0;padding:0 22rpx;border-radius:999rpx;background:rgba(154,114,90,.12);color:#785743;font-size:23rpx}.refresh-task-text::after{border:0}.refresh-task-text[disabled]{opacity:.4}
