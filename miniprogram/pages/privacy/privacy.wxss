.privacy-page{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.updated{margin:-4rpx 0 24rpx}.intro,.body{font-size:26rpx;line-height:1.75}.section-title{margin-bottom:20rpx}.item{padding:18rpx 0;border-bottom:1rpx solid rgba(110,105,99,.11)}.item:last-child{border-bottom:0}.item text{display:block}.item .muted{margin-top:8rpx;font-size:25rpx}.theme-calm .item,.theme-blue .item{border-bottom-color:rgba(255,255,255,.1)}
