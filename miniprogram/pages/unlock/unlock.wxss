.state-card{text-align:center;padding:55rpx 34rpx}
.state-symbol,.lock-symbol{width:100rpx;height:100rpx;border-radius:50%;background:#f0e8e1;color:#a36e65;display:flex;align-items:center;justify-content:center;margin:0 auto 28rpx;font-size:50rpx}
.prompt-preview .section-title{margin-top:15rpx;line-height:1.5}
.my-half image{width:100%;height:500rpx;border-radius:22rpx}
.half-caption{font-size:30rpx;line-height:1.5;margin:20rpx 0 8rpx;max-width:100%;white-space:normal;word-break:break-all;overflow-wrap:anywhere}
.waiting-dots{display:flex;justify-content:center;gap:12rpx;margin-bottom:30rpx}
.waiting-dots text{width:18rpx;height:18rpx;border-radius:50%;background:#e3aaa3}
.date-line{color:#e86f61;font-size:24rpx;margin-bottom:12rpx}
.prompt-title{font-size:36rpx}
.half image{width:100%;height:330rpx;border-radius:22rpx}
.half{min-width:0}
.half view{margin-top:10rpx;max-width:100%;white-space:normal;word-break:break-all;overflow-wrap:anywhere}
.half-identity{color:#e86f61;font-size:23rpx;font-weight:600}
.half-caption-text{line-height:1.5}
.theme-calm .half-identity{color:#f5a8c4}
.theme-blue .half-identity{color:#b9d0ff}
.theme-warm .half-identity{color:#b76758}
.theme-minimal .half-identity{color:#69645f}
.quote{font-size:30rpx;line-height:1.7;text-align:center;padding:42rpx 20rpx}
.quote-switcher{display:flex;align-items:center;justify-content:center;gap:18rpx}
.quote-text{min-width:0;white-space:pre-line}
.quote-switch-icon{flex:none;width:48rpx;height:48rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#e86f61;background:rgba(232,111,97,.11);font-size:31rpx;line-height:1}
.theme-calm .quote-switch-icon{color:#f5a8c4;background:rgba(245,168,196,.12)}
.theme-blue .quote-switch-icon{color:#b9d0ff;background:rgba(185,208,255,.12)}
.theme-warm .quote-switch-icon{color:#b76758;background:rgba(183,103,88,.11)}
.theme-minimal .quote-switch-icon{color:#69645f;background:rgba(105,100,95,.1)}
.themes{display:flex;gap:15rpx;justify-content:center;margin-bottom:22rpx}
.theme{padding:13rpx 28rpx;background:#eee6df;border-radius:999rpx}
.theme.active{background:#e86f61;color:#fff}
.location-option{display:flex;align-items:center;justify-content:space-between;gap:20rpx;background:#fff;padding:22rpx 26rpx;border-radius:20rpx;margin-bottom:22rpx}
.location-option .muted{font-size:22rpx;margin-top:6rpx}
.display-options{display:block;padding:0;overflow:hidden}
.display-option-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:22rpx 26rpx}
.canvas{width:100%;height:440px}
.canvas-full-film{height:700px}
.canvas-full-journal{height:700px}
.canvas-full-minimal{height:700px}
.canvas-source{position:fixed;left:-200vw;top:0;opacity:0;pointer-events:none}
.canvas-preview{display:block;width:100%;border-radius:24rpx}
.canvas-placeholder{height:440px;border-radius:24rpx;display:flex;align-items:center;justify-content:center}
.preview-sheet{height:100vh;background:rgba(0,0,0,.96);display:flex;flex-direction:column;padding-top:calc(110rpx + env(safe-area-inset-top));box-sizing:border-box}
.preview-scroll{flex:1;min-height:0;padding:0 24rpx 30rpx;box-sizing:border-box}
.preview-safe-top{height:20rpx}
.preview-full-image{display:block;width:100%;border-radius:20rpx}
.preview-actions{flex:none;display:flex;gap:20rpx;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:rgba(12,12,13,.96)}
.preview-actions button{flex:1;margin:0;border-radius:999rpx;font-weight:600}
.preview-close{background:#29282a;color:#f4f0ea}
.preview-save{color:#fffdf9;transition:background .2s ease}
.preview-save-minimal{background:#e86f61}
.preview-save-film{background:#d5a756;color:#211812}
.preview-save-journal{background:#6f8b6b}
.preview-save.downloaded,.preview-save[disabled]{opacity:1;color:#fffdf9}
.preview-save-film.downloaded{color:#211812}
.meeting-entry{display:flex;align-items:center;gap:22rpx;margin-top:30rpx}
.meeting-date{width:88rpx;height:88rpx;flex:none;border-radius:22rpx;background:#f1e9e2;display:flex;flex-direction:column;align-items:center;justify-content:center}
.meeting-day,.meeting-year{display:block}
.meeting-day{font-size:27rpx;font-weight:700}
.meeting-year{font-size:20rpx;color:#999;margin-top:3rpx}
.meeting-copy{flex:1}
.meeting-copy .section-title{margin:5rpx 0 7rpx}
.meeting-copy .eyebrow{font-size:20rpx}
.meeting-arrow{font-size:45rpx;color:#a69d96}
.theme-calm .state-symbol,.theme-calm .lock-symbol{background:rgba(255,255,255,.08);color:#d8d0c7;border:1rpx solid rgba(255,255,255,.12)}
.theme-calm .waiting-dots text{background:#e889ad}
.theme-calm .date-line{color:#f5a8c4}
.theme-calm .theme{background:rgba(255,255,255,.08);color:#bbb4ac;border:1rpx solid rgba(255,255,255,.1)}
.theme-calm .theme.active{background:rgba(240,143,179,.94);color:#25151e}
.theme-calm .location-option{background:rgba(10,11,13,.82);color:#f4f0ea;border:1rpx solid rgba(255,255,255,.18);box-shadow:inset 0 0 30rpx rgba(0,0,0,.2)}
.theme-calm .meeting-date{background:rgba(255,255,255,.08);color:#f4f0ea;border:1rpx solid rgba(255,255,255,.1)}
.theme-calm .meeting-year,.theme-calm .meeting-arrow{color:#aaa39c}
.toggle-control{display:flex;align-items:center;gap:12rpx;flex:none}
.switch-state{font-size:21rpx;color:#88827b;min-width:58rpx;text-align:right}
.switch-state.on{color:#b45d53}
.theme-calm .switch-state{color:#aaa39c}
.theme-calm .switch-state.on{color:#f5a8c4}
.theme-blue .state-symbol,.theme-blue .lock-symbol{background:rgba(220,232,255,.08);color:#c6d9ff;border:1rpx solid rgba(174,202,255,.14)}
.theme-blue .waiting-dots text{background:#8fb5ff}
.theme-blue .date-line{color:#b9d0ff}
.theme-blue .theme{background:rgba(220,232,255,.08);color:#b9c8e6;border:1rpx solid rgba(174,202,255,.12)}
.theme-blue .theme.active{background:rgba(143,181,255,.94);color:#07142d}
.theme-blue .location-option{background:rgba(3,8,19,.82);color:#f2f6ff;border:1rpx solid rgba(174,202,255,.18);box-shadow:inset 0 0 30rpx rgba(0,5,18,.2)}
.theme-blue .meeting-date{background:rgba(220,232,255,.08);color:#f2f6ff;border:1rpx solid rgba(174,202,255,.13)}
.theme-blue .meeting-year,.theme-blue .meeting-arrow{color:#9fb0d0}
.theme-blue .switch-state{color:#9fb0d0}
.theme-blue .switch-state.on{color:#b9d0ff}
.theme-warm .state-symbol,.theme-warm .lock-symbol{background:rgba(255,252,245,.5);color:#a36e65;border:1rpx solid rgba(151,99,69,.12)}
.theme-warm .theme{background:rgba(255,252,245,.46);color:#806b60;border:1rpx solid rgba(151,99,69,.11)}
.theme-warm .theme.active{background:rgba(201,121,104,.9);color:#fffaf4}
.theme-warm .location-option{background:rgba(255,250,239,.72);color:#4b352c;border:1rpx solid rgba(151,99,69,.14);box-shadow:inset 0 0 30rpx rgba(119,65,43,.05)}
.theme-warm .meeting-date{background:rgba(255,252,245,.48);color:#4b352c;border:1rpx solid rgba(151,99,69,.11)}
.theme-warm .switch-state{color:#91776a}
.theme-warm .switch-state.on{color:#9b574a}
.theme-minimal .state-symbol,.theme-minimal .lock-symbol{background:rgba(251,249,245,.68);color:#69645f;border:1rpx solid rgba(110,105,99,.12)}
.theme-minimal .waiting-dots text{background:#9a725a}
.theme-minimal .date-line{color:#69645f}
.theme-minimal .theme{background:rgba(251,249,245,.72);color:#77716a;border:1rpx solid rgba(110,105,99,.11)}
.theme-minimal .theme.active{background:rgba(154,114,90,.94);color:#fffdf9}
.theme-minimal .location-option{background:rgba(252,250,246,.84);color:#4d4844;border:1rpx solid rgba(110,105,99,.14);box-shadow:inset 0 0 30rpx rgba(90,82,74,.035)}
.theme-minimal .meeting-date{background:rgba(251,249,245,.76);color:#4d4844;border:1rpx solid rgba(110,105,99,.11)}
.theme-minimal .meeting-year,.theme-minimal .meeting-arrow,.theme-minimal .switch-state{color:#8b847d}
.theme-minimal .switch-state.on{color:#69645f}
.personal-today-grid{grid-template-columns:1fr}
.personal-today-grid .half image{height:560rpx}
.personal-space-note{margin-top:22rpx}
