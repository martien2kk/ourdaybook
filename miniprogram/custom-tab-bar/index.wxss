.tabbar{
  position:fixed;
  left:0;
  right:0;
  bottom:0;
  z-index:1000;
  height:calc(104rpx + env(safe-area-inset-bottom));
  padding-bottom:env(safe-area-inset-bottom);
  box-sizing:border-box;
  display:flex;
  align-items:stretch;
  color:#8b857f;
  border-top:1rpx solid rgba(110,105,99,.12);
  -webkit-backdrop-filter:blur(18rpx) saturate(.96);
  backdrop-filter:blur(18rpx) saturate(.96);
  background:rgba(251,250,247,.9);
}
.tab-item{
  flex:1;
  min-width:0;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:5rpx;
  font-size:20rpx;
  line-height:1;
}
.tab-icon{width:40rpx;height:40rpx}
.theme-minimal{background:rgba(251,250,247,.9);color:#8b857f;border-top-color:rgba(110,105,99,.12)}
.theme-minimal .active{color:#9a725a}
.theme-warm{background:rgba(241,223,200,.54);color:#725e53;border-top-color:rgba(151,99,69,.16);-webkit-backdrop-filter:blur(18rpx) saturate(.9);backdrop-filter:blur(18rpx) saturate(.9)}
.theme-warm .active{color:#b76255}
.theme-calm{background:rgba(17,18,20,.54);color:#aaa39c;border-top-color:rgba(255,255,255,.13);-webkit-backdrop-filter:blur(18rpx) saturate(.9);backdrop-filter:blur(18rpx) saturate(.9)}
.theme-calm .active{color:#f08fb3}
.theme-blue{background:rgba(6,22,58,.86);color:#a8b8d8;border-top-color:rgba(174,202,255,.14)}
.theme-blue .active{color:#8fb5ff}
